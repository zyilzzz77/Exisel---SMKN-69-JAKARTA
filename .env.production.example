# Copy menjadi .env.production di VPS. Jangan commit file hasil salinan.
# Gunakan nilai acak baru; jangan memakai nilai contoh ini di production.
DOMAIN=exisel.web.id
NEXT_PUBLIC_APP_URL=https://exisel.web.id
ACME_EMAIL=ganti-dengan-email-aktif@example.com

POSTGRES_DB=exisel
POSTGRES_USER=exisel
# Gunakan karakter heksadesimal/alfanumerik agar aman di DATABASE_URL.
POSTGRES_PASSWORD=GANTI_DENGAN_HEX_ACAK_MINIMAL_64_KARAKTER
# Minimal 32 karakter. Nilai hex 64-byte direkomendasikan.
SESSION_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_64_KARAKTER

# Google OAuth Web Client. Nilai redirect harus terdaftar persis di Google Cloud.
GOOGLE_CLIENT_ID=GANTI_DENGAN_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=GANTI_DENGAN_GOOGLE_WEB_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://exisel.web.id/api/auth/google/callback
# Opsional; biarkan kosong jika siswa memakai Gmail pribadi.
GOOGLE_ALLOWED_EMAIL_DOMAIN=

# Cloudflare Turnstile (Wajib diisi di production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=GANTI_DENGAN_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=GANTI_DENGAN_TURNSTILE_SECRET_KEY
TURNSTILE_EXPECTED_HOSTNAME=exisel.web.id
TURNSTILE_ENABLED=true
TURNSTILE_SITEVERIFY_TIMEOUT_MS=5000
