# Copy menjadi .env.production di VPS. Jangan commit file hasil salinan.
# Gunakan nilai acak baru; jangan memakai nilai contoh ini di production.
DOMAIN=exisel.web.id
NEXT_PUBLIC_APP_URL=https://exisel.web.id
ACME_EMAIL=ganti-dengan-email-aktif@example.com

POSTGRES_DB=exisel
POSTGRES_USER=exisel
# Gunakan karakter heksadesimal/alfanumerik agar aman di DATABASE_URL.
POSTGRES_PASSWORD=GANTI_DENGAN_HEX_ACAK_MINIMAL_64_KARAKTER
# Minimal 32 karakter. Nilai hex 64-byte direkomendasikan.
SESSION_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_64_KARAKTER
