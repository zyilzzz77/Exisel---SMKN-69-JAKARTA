# Salin menjadi .env.local dan isi dengan kredensial PostgreSQL lokal.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/exisel?schema=public"

# Buat dengan nilai acak minimal 32 karakter. Jangan commit nilai aslinya.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Google OAuth Web Client. Buat di Google Cloud Console.
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-web-client-secret"
# Harus sama persis dengan Authorized redirect URI di Google Cloud.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Opsional. Kosongkan agar akun Gmail pribadi tetap dapat digunakan.
GOOGLE_ALLOWED_EMAIL_DOMAIN=""

# Opsional: Node.js runtime untuk generator laporan Excel lokal.
SPREADSHEET_NODE_EXECUTABLE="C:\\path\\to\\bundled-node.exe"
