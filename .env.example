# Salin menjadi .env.local dan isi dengan kredensial PostgreSQL lokal.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/exisel?schema=public"

# Buat dengan nilai acak minimal 32 karakter. Jangan commit nilai aslinya.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Opsional: Node.js runtime untuk generator laporan Excel lokal.
SPREADSHEET_NODE_EXECUTABLE="C:\\path\\to\\bundled-node.exe"
