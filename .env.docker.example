# Salin berkas ini menjadi .env sebelum menjalankan Docker Compose.
# Gunakan nilai rahasia yang berbeda jika aplikasi bisa diakses orang lain.
POSTGRES_DB=exisel
POSTGRES_USER=exisel
POSTGRES_PASSWORD=ganti-dengan-password-alfanumerik-yang-kuat
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Gunakan false untuk localhost/IP jaringan lokal (HTTP), true untuk HTTPS.
SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Web Client. Lihat GOOGLE_LOGIN.md untuk konfigurasi lengkap.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Opsional. Kosongkan agar akun Gmail pribadi dapat digunakan.
GOOGLE_ALLOWED_EMAIL_DOMAIN=

# Port yang dibuka pada komputer host.
APP_PORT=3000
